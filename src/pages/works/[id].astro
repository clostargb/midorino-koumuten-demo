---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate, isoDate } from '../../lib/format';
import { WORK_CATEGORY_SLUGS } from '../../lib/categories';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, date, area, category, cover, coverAlt, summary } = work.data;
const { Content } = await render(work);
---
<Base title={title} description={summary}>
  <section class="section">
    <div class="container article">
      <p class="eyebrow"><a href={`/works/category/${WORK_CATEGORY_SLUGS[category]}/`}>{category}</a></p>
      <h1>{title}</h1>
      <p class="meta"><time datetime={isoDate(date)}>{formatDate(date)}</time><span class="sep">|</span>{area}</p>
      <Image src={cover} alt={coverAlt} width={1440} loading="eager" />
      <Content />
      <p style="margin-top:48px"><a href="/works/">施工実績の一覧へ</a></p>
    </div>
  </section>
</Base>
